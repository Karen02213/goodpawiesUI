[Unit]
Description=GoodPawies API development server
Documentation=file:__APP_ROOT__/SYSTEMD_DEPLOYMENT.md
After=network-online.target
Wants=network-online.target
PartOf=goodpawies-dev.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=__RUN_AS_USER__
Group=__RUN_AS_GROUP__
WorkingDirectory=__APP_ROOT__/server
Environment=HOME=__RUN_AS_HOME__
Environment=PATH=__NODE_PATH__
Environment=NODE_ENV=development
Environment=PORT=5000
ExecStart=__NPM_BIN__ run dev
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=goodpawies-dev.target